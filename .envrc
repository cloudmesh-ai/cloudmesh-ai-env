# .envrc – automatically loads the uv virtual environment for this project.
# This file expects `uv` (https://github.com/astral-sh/uv) to be installed.
# If `uv` is not found, an informative warning is printed and direnv aborts.

if ! command -v uv > /dev/null; then
  echo "Warning: uv not found. Install uv to manage the virtual environment."
  exit 1
fi

# Create the uv virtual environment in .venv if it doesn't exist yet.
if [ ! -d ".venv" ]; then
  uv venv .venv
fi

# Activate the uv virtual environment using direnv's built‑in layout helper.
layout python .venv/bin/python
